{
  "name": "helix-webpage",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x",
    "npm": "11.17.x"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow npm",
    "postinstall": "npm run build:email-sanitizer",
    "build:email-sanitizer": "node scripts/build-email-sanitizer.mjs",
    "dev": "vite",
    "dev:member": "vite --mode member-local --host 127.0.0.1 --port 5190 --strictPort",
    "dev:sponsor": "vite --mode sponsor-local --host 127.0.0.1 --port 5192 --strictPort",
    "build": "npm run build:email-sanitizer && vite build && node scripts/check-deployment-size.mjs && node scripts/check-vercel-functions.mjs",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=2 --exclude scripts/deployment-guards.test.mjs && node --test scripts/deployment-guards.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --project tsconfig.api.json",
    "typecheck:api:runtime": "tsc --project tsconfig.api.runtime.json",
    "preview": "vite preview",
    "check:deployment-size": "node scripts/check-deployment-size.mjs",
    "neon:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/neon-setup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/montserrat": "^5.2.6",
    "@gsap/react": "^2.1.2",
    "@neondatabase/neon-js": "0.8.0-beta",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.13.15",
    "motion": "^12.23.24",
    "next": "16.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "react-slick": "^0.31.0",
    "resend": "^6.17.2",
    "sanitize-html": "2.18.1",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-slick": "^0.23.13",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/node": "^13.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.25.9",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.93.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vercel": "65.2.0",
    "vite": "^7.1.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@tailwindcss/oxide@4.1.12": true,
    "esbuild@0.14.47": true,
    "esbuild@0.27.0": true,
    "esbuild@0.25.9": true,
    "esbuild@0.23.1": true,
    "sharp@0.34.4": true
  }
}
