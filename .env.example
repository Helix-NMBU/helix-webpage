# Supabase configuration (recruitment and the older site features; not the member CV portal)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Member CV portal — Neon. Server variables have no VITE_ prefix and must stay off the client.
# See docs/features/member-cv-portal/setup.md. Never commit real values.

# Pooled Postgres URL used by the Vercel functions. Apply db/migrations with a direct/unpooled URL.
DATABASE_URL=

# Managed Better Auth base URL, including the /neondb/auth path.
# Google redirect URI: {NEON_AUTH_BASE_URL}/callback/google
NEON_AUTH_BASE_URL=
# Same URL, exposed to the Vite app so the browser can start Google sign-in.
VITE_NEON_AUTH_URL=

# Helix Google OAuth client id. The server checks the stored Google ID token audience against this.
# It is not a VITE_ variable; the browser does not receive it.
GOOGLE_CLIENT_ID=

# Neon Object Storage (private bucket). Credentials use the AWS SDK names from the Neon storage docs.
NEON_S3_ENDPOINT=
NEON_S3_REGION=
NEON_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
