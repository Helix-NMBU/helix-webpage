# Helix applications — Neon. Copy to .env.local and provide your own values.
# Server variables have no VITE_ prefix and must stay off the client.
# See docs/neon-setup.md. Never commit real values.

# Pooled Postgres URL used by the Vercel functions. Apply db/migrations with a direct/unpooled URL.
DATABASE_URL=

# Managed Better Auth base URL, including the /neondb/auth path.
# The API verifies issuer and JWKS against this Neon origin. Do not point it at the website.
# Google redirect URI: {NEON_AUTH_BASE_URL}/callback/google
NEON_AUTH_BASE_URL=
# Browser auth URL. On Vercel this is the same-origin proxy path /api/auth.
# neon-js needs an absolute URL, so the app expands /api/auth to the current origin.
VITE_NEON_AUTH_URL=/api/auth
# True opens the member application on loopback during npm run dev.
# False opens the website; partner OTP is at /sponsorportal-login.
VITE_MEMBER_PLATFORM=false
# Optional extra hosts that may POST to /api/auth, comma-separated.
# helixnmbu.no, www.helixnmbu.no, and the request Host are already allowed.
# AUTH_PROXY_ALLOWED_HOSTS=

# Helix Google OAuth client id. The server checks the stored Google ID token audience against this.
# It is not a VITE_ variable; the browser does not receive it.
GOOGLE_CLIENT_ID=

# Gmail mailbox connection — server-only Google OAuth client and callback state.
# Create a separate Web application OAuth client for Gmail access; do not reuse
# the browser-facing member sign-in configuration unless the Google console is
# explicitly configured for both purposes.
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
# For local development use http://localhost:5190/api/gmail-callback.
# Production must use the exact HTTPS URI registered in Google Cloud Console.
GMAIL_OAUTH_REDIRECT_URI=
# At least 32 random characters. Used to sign the short-lived OAuth state cookie.
GMAIL_OAUTH_STATE_SECRET=
# At least 32 random bytes, encoded as 64 hex characters. Encrypts stored Gmail refresh tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Neon Object Storage (private bucket). Credentials use the AWS SDK names from the Neon storage docs.
NEON_S3_ENDPOINT=
NEON_S3_REGION=
NEON_STORAGE_BUCKET=
NEON_APPLICATIONS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Website transactional email. Disabled by default for local testing.
HELIX_ENVIRONMENT=local
WEBSITE_EMAIL_ENABLED=false
WEBSITE_EMAIL_TEST_RECIPIENTS=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=no-reply@helixnmbu.no
CONTACT_TO_EMAIL=post@helixnmbu.no
