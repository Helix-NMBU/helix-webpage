{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "vite",
  "functions": {
    "api/gmail.ts": {
      "includeFiles": "api/_lib/generated/email-sanitizer.mjs"
    },
    "api/member-cv.ts": {
      "includeFiles": "api/_lib/fonts/*.ttf"
    }
  },
  "rewrites": [
    {
      "source": "/api/partner-deals",
      "destination": "/api/member-login?__module=partner-deals"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__path=:path*"
    },
    {
      "source": "/api/projects",
      "destination": "/api/member-login?__module=projects"
    },
    {
      "source": "/api/gmail-connect",
      "destination": "/api/gmail?action=connect"
    },
    {
      "source": "/api/gmail-callback",
      "destination": "/api/gmail?action=callback"
    },
    {
      "source": "/api/gmail-status",
      "destination": "/api/gmail?action=status"
    },
    {
      "source": "/api/gmail-disconnect",
      "destination": "/api/gmail?action=disconnect"
    },
    {
      "source": "/api/reject",
      "destination": "/api/website?action=reject"
    },
    {
      "source": "/api/apply-confirmation",
      "destination": "/api/website?action=confirmation"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "sh scripts/ignore-docs-build.sh",
  "redirects": [
    {
      "source": "/P1010055%201.png",
      "destination": "/P1010055%201.webp",
      "permanent": true
    },
    {
      "source": "/P1010366%201.png",
      "destination": "/P1010366%201.webp",
      "permanent": true
    },
    {
      "source": "/Silverstone.png",
      "destination": "/Silverstone.webp",
      "permanent": true
    },
    {
      "source": "/Sponsors.png",
      "destination": "/Sponsors.webp",
      "permanent": true
    },
    {
      "source": "/birk%20i%20bil.jpg",
      "destination": "/birk%20i%20bil.webp",
      "permanent": true
    },
    {
      "source": "/cars/Arken.png",
      "destination": "/cars/Arken.webp",
      "permanent": true
    },
    {
      "source": "/cars/B%C3%B8rsen.png",
      "destination": "/cars/B%C3%B8rsen.webp",
      "permanent": true
    },
    {
      "source": "/cars/Casino.png",
      "destination": "/cars/Casino.webp",
      "permanent": true
    },
    {
      "source": "/cost.png",
      "destination": "/cost.webp",
      "permanent": true
    },
    {
      "source": "/lagbilde.jpg",
      "destination": "/lagbilde.webp",
      "permanent": true
    },
    {
      "source": "/peder.png",
      "destination": "/peder.webp",
      "permanent": true
    },
    {
      "source": "/tilt.png",
      "destination": "/tilt.webp",
      "permanent": true
    }
  ]
}
