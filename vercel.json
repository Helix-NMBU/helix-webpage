{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "vite",
  "functions": {
    "api/member-cv.ts": {
      "includeFiles": "api/_lib/fonts/*.ttf"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://ep-rough-truth-barv8aki.neonauth.c-8.eu-central-1.aws.neon.tech/neondb/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
